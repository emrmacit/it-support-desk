.DS_Store
*.pem
Thumbs.db
Desktop.ini

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ========================
# SECURITY - ENV FILES
# ========================
# Block ALL env files (secrets, API keys, credentials)
.env
.env.*
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
!.env.example

# ========================
# SECURITY - DATABASE
# ========================
# SQLite database files (contain user data & passwords)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
prisma/dev.db
prisma/dev.db-journal

# ========================
# SECURITY - KEYS & CERTS
# ========================
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
*.jks

# ========================
# IDE & EDITOR
# ========================
.vscode/
.idea/
*.swp
*.swo
*~

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

